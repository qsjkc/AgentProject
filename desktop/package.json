{
  "name": "detachym-desktop",
  "version": "1.1.0-rc.1",
  "description": "Detachym desktop pet client with cloud-backed account sync and quick chat.",
  "author": "Detachym",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5174 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5174 electron .",
    "test": "cross-env TZ=Asia/Shanghai node --no-warnings ./scripts/test.mjs",
    "test:e2e": "node scripts/e2e/run.mjs --scenario suite",
    "test:e2e:happy": "node scripts/e2e/run.mjs --scenario p1k-happy",
    "test:e2e:runner": "node scripts/e2e/self-test.mjs",
    "test:packaged": "node scripts/verify-packaged.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder --win nsis",
    "pack": "npm run build:renderer && electron-builder --dir"
  },
  "dependencies": {
    "@volcengine/rtc": "^4.66.20",
    "electron-store": "^10.0.1",
    "lucide-react": "^1.27.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.1.4",
    "electron-builder": "^26.0.12",
    "vite": "^5.4.8",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.detachym.desktop",
    "productName": "Detachym",
    "artifactName": "Detachym-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist/releases"
    },
    "files": [
      "electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "dist/renderer/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "language": "2052",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "displayLanguageSelector": true,
      "multiLanguageInstaller": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
